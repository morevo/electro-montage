# ── База данных (MySQL 8, нативно) ──
# Формат: mysql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БАЗЫ
DATABASE_URL="mysql://electromontage:пароль@127.0.0.1:3306/electromontage"

# ── JWT ──
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ── Приложение ──
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# ── Загрузка файлов ──
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Учётные данные администратора — их читает `npm run prisma:seed`.
# Вписывайте СВОИ значения: в git этот файл попадает без секретов.
# Пароль — минимум 16 символов, логин — без «@» (e-mail не используется).
SEED_ADMIN_LOGIN=
SEED_ADMIN_PASSWORD=
