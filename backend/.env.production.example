# ─────────────────────────────────────────────────────────────
# backend/.env на VPS. Файл не коммитится — создаётся один раз вручную.
# Копия-образец: cp backend/.env.production.example backend/.env
# ─────────────────────────────────────────────────────────────

# MySQL 8 на самом сервере (без Docker).
# Пользователя и базу создаём один раз: см. STEP_BY_STEP_GUIDE.md §4.
DATABASE_URL="mysql://electromontage:ЗАМЕНИТЕ_НА_ПАРОЛЬ@127.0.0.1:3306/electromontage"

JWT_ACCESS_SECRET=вывод_openssl_rand_base64_32
JWT_REFRESH_SECRET=другой_вывод_openssl_rand_base64_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

PORT=3001
NODE_ENV=production
# Домен без слэша — единственный разрешённый CORS-origin
FRONTEND_URL=https://abcn77.ru

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Учётные данные администратора (нужны для scripts/create-admin.js):
# логин без «@», пароль от 16 символов.
SEED_ADMIN_LOGIN=логин_без_собаки
SEED_ADMIN_PASSWORD=пароль_от_16_символов
