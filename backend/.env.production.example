# Production Environment Variables for ElectroMontage Backend
# Copy this file to .env on your VPS and fill in the values

# Database
POSTGRES_PASSWORD=your_secure_postgres_password_here

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# App
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://your-domain.ru

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760