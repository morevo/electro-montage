# ── База данных (MySQL 8) ──
# Формат: mysql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БАЗЫ
DATABASE_URL="mysql://electromontage:apppass@127.0.0.1:3306/electromontage"

# ── JWT ──
# Секреты НЕ перегенерируются на каждом деплое — иначе всех разлогинит.
JWT_ACCESS_SECRET="electro-montage-super-secret-access-key-2024-min-32-chars-long"
JWT_REFRESH_SECRET="electro-montage-super-secret-refresh-key-2024-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ── Приложение ──
# production включает secure-cookie; всё, кроме него, считается разработкой.
APP_ENV=development
FRONTEND_URL="http://localhost:5173"

# ── Загрузка файлов ──
# Путь относительно каталога api/ (на сервере задаётся абсолютным).
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=10485760

# Манифест портфолио для bin/seed-portfolio.php (относительно api/).
PORTFOLIO_MANIFEST="storage/portfolio-manifest.json"

# Учётные данные администратора — читает bin/seed-admin.php.
# Логин без «@» (e-mail не используется), пароль — минимум 16 символов.
SEED_ADMIN_LOGIN=
SEED_ADMIN_PASSWORD=
