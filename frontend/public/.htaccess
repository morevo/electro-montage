# SPA-роутинг + PHP API на Apache (shared-хостинг reg.ru).
# Фронтенд — статика в веб-корне, API — PHP в каталоге /api (Apache запускает
# его сам через FastCGI, постоянного процесса нет).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # API обслуживает PHP front controller /api/index.php.
  # Условие защищает от повторного переписывания уже переписанного запроса.
  RewriteCond %{REQUEST_URI} !^/api/index\.php$
  RewriteRule ^api(/.*)?$ /api/index.php [L,QSA]

  # Фото (/uploads/portfolio/*) лежат прямо в веб-корне и отдаются статикой,
  # без PHP — иначе галерея грузится медленно.

  # Существующие файлы и папки отдаём как есть
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Всё остальное — index.html (клиентский роутинг React)
  RewriteRule . /index.html [L]
</IfModule>

# Кэширование статики
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
