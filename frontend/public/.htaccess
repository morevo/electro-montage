# SPA-роутинг для статики на Apache (shared-хостинг reg.ru).
# Нужен только если фронтенд лежит на Хост-А, а API — на VPS (api.<домен>).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # API обслуживает локальный NestJS на 127.0.0.1:3001.
  # mod_proxy на shared-хостинге выключен, поэтому ходим через api.php (curl).
  # Фото (/uploads/portfolio/*) лежат прямо в веб-корне и отдаются статикой,
  # без прокси — иначе галерея грузится медленно.
  RewriteRule ^api(/.*)?$ /api.php [L,QSA]

  # Существующие файлы и папки отдаём как есть
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Всё остальное — index.html (клиентский роутинг React)
  RewriteRule . /index.html [L]
</IfModule>

# Кэширование статики
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
