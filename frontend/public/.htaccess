<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Не трогаем реально существующие файлы и папки
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Всё остальное отдаём в index.html — маршрутизацию берёт на себя React Router
  RewriteRule ^ index.html [L]
</IfModule>
